trait Eq {
    bool (borrow Self self) eq(borrow Self other);
}

struct Box<T> { T value; };

impl<T: Eq> Eq for Box<T> {
    bool (borrow Self self) eq(borrow Box<T> other) { return self.value == other.value; }
}

trait Shape {
    i32 (borrow Self self) area();
    i32 (borrow Self self) doubled() { return self.area() * 2; }
}

struct Square { i32 side; };

impl Shape for Square {
    i32 (borrow Square self) area() { return self.side * self.side; }
}

i32 main() {
    Square sq = Square { side: 2 };
    i32 a = sq.area();
    return a + sq.doubled();
}
